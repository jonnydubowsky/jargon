<aside class="hidden md:block w-64 shrink-0">
  <div class="sticky top-24 space-y-6 text-sm">
    <div class="surface-alt border border-default rounded-lg p-4">
      <h3 class="font-semibold text-heading mb-3">Quick Start</h3>
      <ul class="space-y-2 text-muted">
        <li class="flex gap-2">
          <span class="text-blue-500">1.</span>
          <span>Paste a <strong class="text-body">URL</strong> to ingest articles, videos, or papers</span>
        </li>
        <li class="flex gap-2">
          <span class="text-blue-500">2.</span>
          <span>Ask a <strong class="text-body">question</strong> to search your library</span>
        </li>
        <li class="flex gap-2">
          <span class="text-blue-500">3.</span>
          <span>Click <strong class="text-body">Explore</strong> to discover related content</span>
        </li>
      </ul>
    </div>

    <%= link_to negative_space_path, class: "block surface-alt border border-default rounded-lg p-4 hover:border-strong transition-colors" do %>
      <h3 class="font-semibold text-heading mb-1 flex items-center gap-2">
        Negative Space
        <span class="text-blue-400">→</span>
      </h3>
      <p class="text-muted text-xs leading-relaxed">See what your library <em>isn't</em> saying yet — and turn a blind spot into research.</p>
    <% end %>

    <div class="surface-alt border border-default rounded-lg p-4">
      <h3 class="font-semibold text-heading mb-3">Supported Content</h3>
      <ul class="space-y-1.5 text-muted">
        <li class="flex items-center gap-2">
          <%= image_tag "article.png", class: "h-4 w-4 opacity-70" %>
          <span>Web articles</span>
        </li>
        <li class="flex items-center gap-2">
          <%= image_tag "video.png", class: "h-4 w-4 opacity-70" %>
          <span>YouTube videos</span>
        </li>
        <li class="flex items-center gap-2">
          <%= image_tag "paper.png", class: "h-4 w-4 opacity-70" %>
          <span>PDFs & academic papers</span>
        </li>
        <li class="flex items-center gap-2">
          <%= image_tag "search.png", class: "h-4 w-4 opacity-70" %>
          <span>Web search results</span>
        </li>
      </ul>
    </div>

    <div class="surface-alt border border-default rounded-lg p-4">
      <h3 class="font-semibold text-heading mb-3">How It Works</h3>
      <ul class="space-y-1.5 text-muted text-xs">
        <li><strong class="text-body">Ingest</strong> &mdash; Content is scraped and parsed</li>
        <li><strong class="text-body">Summarize</strong> &mdash; AI distills key points</li>
        <li><strong class="text-body">Extract</strong> &mdash; Insights become linked cards</li>
        <li><strong class="text-body">Connect</strong> &mdash; Similar content clusters</li>
        <li><strong class="text-body">Thread</strong> &mdash; Research questions find more</li>
      </ul>
    </div>
  </div>
</aside>
