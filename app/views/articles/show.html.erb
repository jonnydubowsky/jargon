<% content_for(:title) { "#{@article.title.presence || @article.url.truncate(50)} | Jargon" } %>
<%= subscribe_to(@article) %>

<% if current_trail&.trail_steps&.opened&.exists?(subject: @article) %>
  <div class="mb-4 text-sm text-muted">
    On trail:
    <%= link_to current_trail.display_name, trail_path(current_trail), class: "text-blue-400 hover:underline" %>
  </div>
<% end %>

<%= render "articles/article_page", article: @article %>
