# Secret key base for session encryption (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=

# LLM provider API keys - set only the ones you use
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model and provider configuration (optional - defaults shown)
# LLM_MODEL=google/gemini-2.5-flash
# LLM_PROVIDER=openrouter
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_PROVIDER=openrouter

# External services
EXA_API_KEY=

# Local vault export (Obsidian, Entailment, or any markdown folder)
# JARGON_VAULT_PATH=/path/to/your/vault
# JARGON_VAULT_INSIGHTS_FOLDER=Insights

# InfraNodus (optional — dry-runs / stubs when unset)
# Get a token at https://infranodus.com/api-access
# INFRANODUS_API_KEY=
# INFRANODUS_GRAPH_NAME=jargon-insights
# INFRANODUS_BASE_URL=https://infranodus.com/api/v1